<?xml version="1.0" encoding="utf-8"?><!--
   黑龙江工商学院 VPN 客户端 —— 主连接页
   布局与 PC 客户端（index.html）逐项对齐：
     状态圆环 → 节点/账号/密码三栏 → 记住复选框 → 连接按钮 → 连接信息 → 页脚

   ⚠️ 铁律：每个控件的 layout_width / layout_height 必须【显式写在本文件】，
      不要依赖 style 提供 —— style 缺了会在 inflate 时抛
      "You must supply a layout_width attribute" 直接闪退。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <!-- ═══ 学校标识：校徽 + 校名（在状态圆环上方）═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="18dp"
            android:paddingBottom="16dp">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:src="@drawable/ic_school_logo"
                android:contentDescription="@string/pc_brand_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/ink"
                android:text="@string/pc_brand_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12.5sp"
                android:textColor="@color/ink2"
                android:letterSpacing="0.06"
                android:text="@string/pc_brand_sub" />
        </LinearLayout>

        <!-- ═══ 状态圆环卡片 ═══ -->
        <LinearLayout
            style="@style/pc.card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <FrameLayout
                android:id="@+id/ring"
                android:layout_width="126dp"
                android:layout_height="126dp"
                android:background="@drawable/pc_ring"
                android:backgroundTint="@color/ink3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink3"
                        android:text="@string/pc_status_off" />

                    <TextView
                        android:id="@+id/status_msg"
                        android:layout_width="108dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:textSize="10.5sp"
                        android:textColor="@color/ink3"
                        android:text="@string/pc_status_hint" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ═══ 表单卡片 ═══ -->
        <LinearLayout
            style="@style/pc.card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/pc.sectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pc_section_account" />

            <!-- 节点 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="9dp">

                <TextView
                    style="@style/pc.fieldLabel"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:text="@string/pc_field_node" />

                <Spinner
                    android:id="@+id/node_spinner"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/pc_select"
                    android:paddingStart="11dp"
                    android:paddingEnd="28dp"
                    android:textSize="13sp"
                    android:textColor="@color/ink"
                    android:spinnerMode="dialog" />
            </LinearLayout>

            <!-- 账号 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="9dp">

                <TextView
                    style="@style/pc.fieldLabel"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:text="@string/pc_field_user" />

                <EditText
                    android:id="@+id/user_input"
                    style="@style/pc.input"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="@string/pc_hint_user"
                    android:inputType="text"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <!-- 密码 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    style="@style/pc.fieldLabel"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:text="@string/pc_field_pass" />

                <EditText
                    android:id="@+id/pass_input"
                    style="@style/pc.input"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="@string/pc_hint_pass"
                    android:inputType="textPassword"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <!-- 复选框行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="14dp">

                <CheckBox
                    android:id="@+id/remember_user"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/brand"
                    android:textSize="12sp"
                    android:textColor="@color/ink2"
                    android:text="@string/pc_remember_user" />

                <CheckBox
                    android:id="@+id/auto_connect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:buttonTint="@color/brand"
                    android:textSize="12sp"
                    android:textColor="@color/ink2"
                    android:text="@string/pc_auto_connect" />
            </LinearLayout>

            <!-- 主按钮 -->
            <Button
                android:id="@+id/action_btn"
                style="@style/pc.button"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="@string/pc_btn_connect" />
        </LinearLayout>

        <!-- ═══ 连接信息卡片 ═══ -->
        <LinearLayout
            style="@style/pc.card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/pc.sectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pc_section_info" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:background="@color/line" />

            <LinearLayout
                style="@style/pc.infoRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    style="@style/pc.infoKey"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pc_info_state" />
                <TextView
                    android:id="@+id/info_state"
                    style="@style/pc.infoValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—" />
            </LinearLayout>

            <LinearLayout
                style="@style/pc.infoRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    style="@style/pc.infoKey"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pc_info_node" />
                <TextView
                    android:id="@+id/info_node"
                    style="@style/pc.infoValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—" />
            </LinearLayout>

            <LinearLayout
                style="@style/pc.infoRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    style="@style/pc.infoKey"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pc_info_duration" />
                <TextView
                    android:id="@+id/info_duration"
                    style="@style/pc.infoValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—" />
            </LinearLayout>

            <LinearLayout
                style="@style/pc.infoRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    style="@style/pc.infoKey"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pc_info_traffic" />
                <TextView
                    android:id="@+id/info_traffic"
                    style="@style/pc.infoValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ 页脚：信息中心 + 关于（点「关于」看软件信息/日志）═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="9dp"
            android:paddingBottom="11dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10.5sp"
                android:textColor="@color/ink3"
                android:text="@string/pc_footer" />

            <TextView
                android:id="@+id/about_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textSize="10.5sp"
                android:textColor="@color/brand"
                android:text="@string/pc_about_link" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
